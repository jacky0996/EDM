# Cloud Run 用 nginx 模板。
# 啟動時用 envsubst 把 ${PORT} / ${EDM_BACKEND_URL} / ${SSO_URL} 替換成實際值。
# Cloud Run 自動注入:
#   - PORT(預設 8080)
# 我們自己在 Cloud Run service 設定:
#   - EDM_BACKEND_URL=https://edm-backend-xxxxx.asia-east1.run.app
#   - SSO_URL=https://middleplatform-xxxxx.asia-east1.run.app

worker_processes 1;

error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;

  types {
    application/javascript mjs;
  }

  sendfile on;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json application/xml text/xml;

  # Cloud Run 上 nginx 不能 hard-code 80,要用 $PORT
  server {
    listen ${PORT} default_server;
    server_name _;

    location / {
      root /usr/share/nginx/html;
      try_files $uri $uri/ /index.html;
      index index.html;
    }

    # === 業務 API 反向代理到 edm-backend Cloud Run ===
    location /api/ {
      proxy_pass ${EDM_BACKEND_URL}/api/;
      proxy_set_header Host ${EDM_BACKEND_HOST};
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_ssl_server_name on;
    }

    # === SSO 反向代理到中台 middleplatform Cloud Run ===
    location /api-sso/ {
      proxy_pass ${SSO_URL}/api/;
      proxy_set_header Host ${SSO_HOST};
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_ssl_server_name on;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
      root /usr/share/nginx/html;
    }
  }
}
