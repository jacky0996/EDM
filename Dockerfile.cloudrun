# Cloud Run 用 image。
# 多階段 build:
#   1. pnpm build:ele 產 SPA bundle
#   2. nginx:alpine 包好 + 我們的 nginx 模板 + entrypoint
# Cloud Run 注入 PORT、我們自己注入 EDM_BACKEND_URL / SSO_URL。

# ============= Builder stage =============
FROM node:22-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV TZ=Asia/Taipei

RUN corepack enable && corepack prepare pnpm@10.4.0 --activate

WORKDIR /app
COPY . /app

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

ARG APP_ENV=production
ENV VITE_APP_ENV=${APP_ENV}

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm config set fetch-retries 5 && \
    pnpm config set fetch-retry-mintimeout 20000 && \
    pnpm config set fetch-retry-maxtimeout 120000 && \
    pnpm install --no-frozen-lockfile --reporter=append-only --registry=https://registry.npmjs.org

RUN pnpm run build:ele -- --mode ${VITE_APP_ENV}

# ============= Runtime stage =============
FROM nginx:stable-alpine AS production

# envsubst 來自 gettext
RUN apk add --no-cache gettext

# 我們自己的 nginx config 模板 + entrypoint
COPY scripts/deploy/nginx.cloudrun.conf.template /etc/nginx/templates/nginx.cloudrun.conf.template
COPY scripts/deploy/entrypoint.cloudrun.sh /usr/local/bin/entrypoint.cloudrun.sh
RUN chmod +x /usr/local/bin/entrypoint.cloudrun.sh

# 拿掉 nginx 預設 server 設定
RUN rm -f /etc/nginx/conf.d/default.conf

# 補 .mjs 的 mime type
RUN echo "types { application/javascript js mjs; }" > /etc/nginx/conf.d/mjs.conf

# 靜態檔
COPY --from=builder /app/apps/web-ele/dist /usr/share/nginx/html

# Cloud Run 期望 $PORT(預設 8080)
ENV PORT=8080
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.cloudrun.sh"]
